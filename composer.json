{
    "name": "leads/core",
    "description": "Shared core library for Leads",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Lahoiski",
            "email": "maxim.l@dot818.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "doctrine/dbal": "^4.0",
        "symfony/dependency-injection": "^7.2 || ^8.0",
        "symfony/http-foundation": "^7.2 || ^8.0",
        "symfony/http-kernel": "^7.2 || ^8.0",
        "symfony/config": "^7.2 || ^8.0",
        "symfony/validator": "^7.2 || ^8.0",
        "symfony/yaml": "^7.2 || ^8.0"
    },
    "require-dev": {
        "smi2/phpclickhouse": "^1.6 || ^1.26"
    },
    "suggest": {
        "smi2/phpclickhouse": "Required to use Leads\\Core\\Pagination\\ClickHousePagination (^1.6 || ^1.26)"
    },
    "autoload": {
        "psr-4": {
            "Leads\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leads\\Core\\Tests\\": "tests/"
        }
    }
}
